{
  "$schemaVersion": 1,
  "name": "SewerAction",
  "bundleId": { "ios": "com.tactile.seweraction", "android": "com.tactile.seweraction" },
  "version": "0.1.0",
  "sim": { "dt": 0.016666667, "maxStepsPerFrame": 5, "physicsThreads": 1, "hashInDev": true, "seed": 1 },
  "js": { "entry": "src/main.ts", "target": "es2020" },
  "render": {
    "defaultTier": "auto",
    "tiers": { "mobile": { "msaa": 1, "hdr": false }, "compat": { "msaa": 1, "hdr": false } },
    "clearColor": [0.035, 0.055, 0.075, 1],
    "sortingLayers": ["Background", "World", "Characters", "Effects", "Foreground"],
    "pixelsPerUnit": 100
  },
  "atlas": { "auto": true, "maxPageSize": { "desktop": 4096, "mobile": 2048 }, "pot": false },
  "audio": { "banks": ["audio/core.bank"], "loudness": -16, "normalize": true, "maxVoices": 24, "overrides": { "phone-low": { "maxVoices": 12 } } },
  "ui": { "referenceResolution": [1920, 1080], "orientation": "landscape" },
  "assets": {
    "groups": {
      "boot": { "include": ["assets/settings/**", "assets/fonts/Abel-Regular.ttf", "assets/art/start-screen.png", "assets/art/effects/water-splash.clip2d.json", "assets/art/effects/water-splash/**", "assets/audio/sfx/*.wav", "prefabs/player-projectile.prefab.json", "prefabs/enemy-bullet.prefab.json", "prefabs/enemy-bomb.prefab.json", "assets/art/effects/muzzle.clip2d.json", "assets/art/effects/hit.clip2d.json", "assets/art/effects/explosion.clip2d.json", "assets/art/effects/*.vfx.json", "assets/art/effects/hit/**", "assets/art/effects/hit-sheet.png", "assets/art/effects/bullet/muzzle-flash.png"] },
      "gameplay": {
        "include": [
          "assets/art/environment/**",
          "assets/art/player/**",
          "assets/art/soldier/**",
          "assets/art/effects/**",
          "assets/rooms/**",
          "scenes/main.scene.json",
          "scenes/comparison.scene.json",
          "scenes/complete-sewer.scene.json"
        ]
      }
    }
  },
  "memory": { "budgets": { "phone-low": { "total": "192MB", "textures": "128MB", "audio": "32MB" } } },
  "bundles": [{ "name": "base", "include": ["**"], "delivery": "in-app", "exclude": ["assets/audio/sfx/rainbowlaser.ogg"] }],
  "targets": ["ios", "android"],
  "platforms": ["web"],
  "startScene": "scenes/complete-sewer.scene.json",
  "check": { "smoke": { "frames": 120, "uiNodes": 64 } }
}
